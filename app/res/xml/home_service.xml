<?xml version="1.0" encoding="utf-8"?>
<!--
  Der Service braucht zwei Dinge von Android:
   - zu wissen, welches Fenster vorne ist (typeWindowStateChanged)
   - ein Overlay ueber Amazons Homescreen legen zu duerfen (TYPE_ACCESSIBILITY_OVERLAY)
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/svc_desc" />
